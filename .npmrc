# GitHub Packages is scoped-only. Routing just @ehealth-co-id keeps the factory's own
# unscoped deps (mutative, yargs, ttsc, typescript, typia) resolving to npmjs — pointing
# the *default* registry at npm.pkg.github.com would 404 every `npm ci`.
@ehealth-co-id:registry=https://npm.pkg.github.com
# Expanded from the environment at read time, so no token is ever in the repo.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
